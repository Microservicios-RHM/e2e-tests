# Copie este archivo a .env (no se versiona) o exporte las variables en el entorno de CI.

# URL del API Gateway. Fuera de Docker: http://localhost:8080. Dentro de la red de Compose:
# http://api-gateway:8080
BASE_URL=http://localhost:8080

# Administrador semilla de auth-service (ADMIN_USERNAME / ADMIN_PASSWORD del docker-compose.yml).
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=change_admin_password

# Contraseña con la que la suite activa las cuentas USER que crea (≥ 8 caracteres, letra y dígito).
E2E_USER_PASSWORD=Clave2026segura

# Polling de eventos asíncronos: 15 intentos × 2 s = 30 s de espera máxima por condición.
E2E_POLL_MAX_ATTEMPTS=15
E2E_POLL_INTERVAL_MS=2000

# Ventana de confirmación de condiciones negativas: 3 observaciones × 2 s.
E2E_QUIET_ATTEMPTS=3
E2E_QUIET_INTERVAL_MS=2000
